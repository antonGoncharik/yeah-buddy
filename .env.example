# URL приложения на Vercel
NEXT_PUBLIC_APP_URL=

# Адрес Supabase
SUPABASE_URL=
# Серверный ключ. Не использовать в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=

# Токен бота. Не использовать в клиентском коде.
TELEGRAM_BOT_TOKEN=
# URL Mini App, обычно тот же домен
TELEGRAM_MINI_APP_URL=

# Секрет для подписи сессии (минимум 32 символа, например: openssl rand -base64 48)
SESSION_SECRET=

# Секрет крона напоминаний. Vercel Cron шлёт его как Bearer.
CRON_SECRET=

# Telegram id автора. Ему бот приносит «Написать» из настроек.
# Узнать id: @userinfobot. Без этого кнопки нет.
INBOX_CHAT_ID=

# Ключи текста «Как прошло». До четырёх через запятую (ротация при лимите API).
# Каждый ключ — свой проект Google: в одном проекте квота общая. На человека — 3 разбора в день.
GEMINI_API_KEY=
# Ключи фото тарелки. До четырёх через запятую. На человека — 3 фото в день.
# Без них ссылка «Фото тарелки» скрыта, дневник жив.
GEMINI_PLATE_API_KEY=
# Ключи голоса «Голосом». До четырёх через запятую. На человека — 3 записи в день.
# Без них кнопка скрыта, дневник жив.
GEMINI_DICTATE_API_KEY=
# Ключи текстового ввода на Today («овсянка 80 г…»). До четырёх через запятую. На человека — 3 строки в день.
# Без них блок «Текстом» скрыт.
GEMINI_TEXT_API_KEY=
