# URL приложения на Vercel
NEXT_PUBLIC_APP_URL=

# Адрес Supabase
SUPABASE_URL=
# Серверный ключ. Не использовать в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=

# Токен бота. Не использовать в клиентском коде.
TELEGRAM_BOT_TOKEN=
# URL Mini App, обычно тот же домен
TELEGRAM_MINI_APP_URL=

# Секрет для подписи сессии (минимум 32 символа, например: openssl rand -base64 48)
SESSION_SECRET=

# Секрет крона напоминаний. Vercel Cron шлёт его как Bearer.
CRON_SECRET=

# Ключ текста «Как прошло». Без него разбор покажет только цифры.
GEMINI_API_KEY=
# Ключ фото тарелки. Без него ссылка «Фото тарелки» скрыта, дневник жив.
# Лучше отдельный проект Google: ключи одного проекта делят квоту Gemini.
GEMINI_PLATE_API_KEY=
# Необязательно. Фото тарелки. По умолчанию: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Необязательно. Текст «Как прошло». По умолчанию: gemini-3.5-flash
GEMINI_REVIEW_MODEL=gemini-3.5-flash
# Необязательно. Фото на человека в календарный день. По умолчанию 8. 0 — без лимита приложения.
GEMINI_PLATE_DAILY_LIMIT=8
# Необязательно. Разборы на человека в календарный день. По умолчанию 6. 0 — без лимита приложения.
GEMINI_REVIEW_DAILY_LIMIT=6
