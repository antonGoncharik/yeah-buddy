# URL приложения на Vercel
NEXT_PUBLIC_APP_URL=

# Адрес Supabase
SUPABASE_URL=
# Серверный ключ. Не использовать в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=

# Токен бота. Не использовать в клиентском коде.
TELEGRAM_BOT_TOKEN=
# URL Mini App, обычно тот же домен
TELEGRAM_MINI_APP_URL=

# Секрет для подписи сессии (минимум 32 символа, например: openssl rand -base64 48)
SESSION_SECRET=

# Секрет крона напоминаний. Vercel Cron шлёт его как Bearer.
CRON_SECRET=

# Ключ для текста разбора. Без него экран покажет только цифры.
GEMINI_API_KEY=
# Необязательно. Модель по умолчанию: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
